# From Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_TOKEN=PASTE_PERMANENT_SYSTEM_USER_TOKEN
PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID
# You invent this; paste same value in Meta webhook config
VERIFY_TOKEN=my-super-secret-verify-token
PORT=3000

# Your personal WhatsApp number (country code, no +) to receive handover alerts
ADMIN_PHONE=2348012345678
# Display name shown in messages
SHOP_NAME=Paragon Hub

# ---- Payments (leave empty = MANUAL mode: transfer + ref + "paid" keyword) ----
# Get these from dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
# Optional: page to return to after web payment (you may not need this for WhatsApp-only)
PAYSTACK_CALLBACK_URL=
# Shown to customers in MANUAL mode, e.g. "GTB 0123456789 - Paragon Hub"
SHOP_ACCOUNT_DETAILS=
# Orders at/above this (NGN) split into 50% deposit + 50% before delivery
INSTALLMENT_THRESHOLD=20000

# ---- Growth (all optional; leave empty = graceful fallback, nothing breaks) ----
# Sticker media link/ID celebrated on completed orders (WebP 512x512)
STICKER_CELEBRATE=
# WhatsApp Flow ID for the one-screen order form (see FLOWS.md; customers type "form")
FLOW_ID=
# Bot's own WhatsApp number (country code, no +) — enables tap-to-share referral links
BOT_NUMBER=

# ---- Cloud backup (keeps orders safe on Render restarts; see LAUNCH.md Step 8) ----
# Free Supabase project → Project URL + service_role key. Empty = local JSON only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Approved template names (see TEMPLATES.md; /remind uses TEMPLATE_REMINDER)
TEMPLATE_REMINDER=
TEMPLATE_ORDER_UPDATE=
TEMPLATE_DELIVERY_DONE=
TEMPLATE_PROMO=
